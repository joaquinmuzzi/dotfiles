#!/usr/bin/env bash

set -euo pipefail

readonly PID_FILE="/tmp/grabar_ffmpeg.pid"
readonly OUT_FILE_REF="/tmp/grabar_output_path"
readonly LOG_FILE="/tmp/grabar_ffmpeg.log"
readonly OUTPUT_DIR="$HOME/Videos/recordings"

notify() {
  local title="$1"
  local message="$2"

  if command -v dunstify >/dev/null 2>&1; then
    dunstify "$title" "$message" -t 3000
  elif command -v notify-send >/dev/null 2>&1; then
    notify-send "$title" "$message"
  fi
}

is_running() {
  local pid="$1"
  kill -0 "$pid" 2>/dev/null
}

start_recording() {
  local record_mic="$1"
  local record_sys="$2"
  
  mkdir -p "$OUTPUT_DIR"

  local ts output
  ts="$(date +"%Y-%m-%d_%H-%M-%S")"
  output="$OUTPUT_DIR/grabacion_${ts}.mp4"

  local -a ffmpeg_args=(
    -f x11grab -video_size 1920x1200 -framerate 60 -i :0.0
  )

  local sys_input="default"
  local mic_input="alsa_input.pci-0000_00_1f.3.analog-stereo"

  if [[ "$record_sys" == "true" && "$record_mic" == "true" ]]; then
    ffmpeg_args+=(
      -f pulse -i "$sys_input"
      -f pulse -i "$mic_input"
      -filter_complex "[1:a][2:a]amix=inputs=2[aout]"
      -map 0:v -map "[aout]"
    )
  elif [[ "$record_sys" == "true" ]]; then
    ffmpeg_args+=(
      -f pulse -i "$sys_input"
      -map 0:v -map 1:a
    )
  elif [[ "$record_mic" == "true" ]]; then
    ffmpeg_args+=(
      -f pulse -i "$mic_input"
      -map 0:v -map 1:a
    )
  else
    ffmpeg_args+=(
      -map 0:v
    )
  fi

  ffmpeg_args+=(
    -c:v libx264 -preset ultrafast -crf 23 -pix_fmt yuv420p -movflags +faststart
  )

  if [[ "$record_sys" == "true" || "$record_mic" == "true" ]]; then
    ffmpeg_args+=(
      -c:a aac -b:a 192k
    )
  fi

  nohup ffmpeg "${ffmpeg_args[@]}" "$output" >"$LOG_FILE" 2>&1 &

  local pid=$!
  echo "$pid" >"$PID_FILE"
  echo "$output" >"$OUT_FILE_REF"

  sleep 0.2
  if is_running "$pid"; then
    local msg="Audio: "
    [[ "$record_sys" == "true" ]] && msg+="Sistema "
    [[ "$record_mic" == "true" ]] && msg+="Micro "
    [[ "$record_sys" == "false" && "$record_mic" == "false" ]] && msg+="Silencio"
    
    notify "Grabacion iniciada" "$msg\nGuardando en: $output"
  else
    rm -f "$PID_FILE" "$OUT_FILE_REF"
    notify "Error al grabar" "ffmpeg no pudo iniciar. Revisa $LOG_FILE"
    exit 1
  fi
}

stop_recording() {
  local pid output
  pid="$(cat "$PID_FILE")"
  output="$(cat "$OUT_FILE_REF" 2>/dev/null || true)"

  if ! is_running "$pid"; then
    rm -f "$PID_FILE" "$OUT_FILE_REF"
    notify "Grabacion detenida" "No habia grabacion activa"
    return 0
  fi

  kill -INT "$pid" 2>/dev/null || true

  for _ in $(seq 1 50); do
    if ! is_running "$pid"; then
      break
    fi
    sleep 0.1
  done

  if is_running "$pid"; then
    kill -TERM "$pid" 2>/dev/null || true
  fi

  rm -f "$PID_FILE" "$OUT_FILE_REF"

  if [[ -n "$output" ]]; then
    notify "Grabacion detenida" "Archivo guardado: $output"
  else
    notify "Grabacion detenida" "Grabacion finalizada"
  fi
}

main() {
  if [[ -f "$PID_FILE" ]]; then
    stop_recording
  else
    local record_mic=true
    local record_sys=true

    while [[ $# -gt 0 ]]; do
      case "$1" in
        --no-mic) record_mic=false; shift ;;
        --no-sys) record_sys=false; shift ;;
        --mic-only) record_sys=false; record_mic=true; shift ;;
        --sys-only) record_mic=false; record_sys=true; shift ;;
        --no-audio) record_mic=false; record_sys=false; shift ;;
        *) shift ;;
      esac
    done

    start_recording "$record_mic" "$record_sys"
  fi
}

main "$@"
